@model Quest

@{
    ViewData["Title"] = "Add Quest";
}

<h2>Add Quest</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label>
        Name
    </label>

    <input asp-for="Name" />

    <span asp-validation-for="Name"></span>

    <label>
        Status
    </label>

    <select asp-for="Status">
        <option value="">
            Select
        </option>

        <option>
            Not Started
        </option>

        <option>
            In Progress
        </option>

        <option>
            Complete
        </option>
    </select>

    <span asp-validation-for="Status"></span>

    <label>
        Priority
    </label>

    <select asp-for="Priority">
        <option value="">
            Select
        </option>

        <option>
            Low
        </option>

        <option>
            Medium
        </option>

        <option>
            High
        </option>
    </select>

    <span asp-validation-for="Priority"></span>

    <label>
        Related Activity
    </label>

    <input asp-for="RelatedActivity" />

    <label>
        Completion Notes
    </label>

    <textarea asp-for="CompletionNotes"></textarea>

    <label>
        Notes
    </label>

    <textarea asp-for="Notes"></textarea>

    <button type="submit">
        Save
    </button>

    <a asp-action="Index">
        Cancel
    </a>
</form>