@model IEnumerable<RaidersVault.Models.InventoryItem>
@{ ViewData["Title"] = "Item Database"; }
<section class="hero-panel feature-hero"><div><span class="eyebrow">MetaForge-style database</span><h1>Item Database & Needed Items Tracker</h1><p>Track materials, blueprint ingredients, keep counts, rarity, source, sell value, and what still needs to be farmed.</p></div></section>
<form method="get" class="filter-bar command-card"><input name="search" value="@ViewBag.Search" placeholder="Search item, source, or use..." /><label class="checkline"><input type="checkbox" name="hideStocked" value="true" checked="@(ViewBag.HideStocked == true)" /> Hide stocked</label><button class="button primary" type="submit">Filter Database</button></form>
<section class="kpi-grid"><article class="kpi-card"><span>Total Items</span><strong>@Model.Count()</strong><small>tracked rows</small></article><article class="kpi-card"><span>Needed</span><strong>@Model.Count(x => x.Needed > 0)</strong><small>not at target</small></article><article class="kpi-card"><span>Critical</span><strong>@Model.Count(x => x.Priority == "Critical")</strong><small>rare gaps</small></article><article class="kpi-card"><span>Vault Value</span><strong>@Model.Sum(x => x.SellValue * x.CurrentCount)</strong><small>estimated value</small></article></section>
<section class="database-grid">@foreach (var item in Model){<article class="database-card"><div class="card-topline"><span class="rarity @item.Rarity.ToLower()">@item.Rarity</span><span>@item.Priority</span></div><h2>@item.Name</h2><p>@item.Notes</p><dl class="intel-list"><div><dt>Category</dt><dd>@item.Category</dd></div><div><dt>Source</dt><dd>@item.BestSource</dd></div><div><dt>Used For</dt><dd>@item.UsedFor</dd></div><div><dt>Need</dt><dd>@item.Needed remaining</dd></div></dl><form asp-action="UpdateCount" method="post" class="count-update"><input type="hidden" name="id" value="@item.Id" /><label>Have <input type="number" min="0" name="currentCount" value="@item.CurrentCount" /></label><span>Keep @item.KeepTarget</span><button class="button small" type="submit">Update</button></form></article>}</section>
