@model RaidersVault.ViewModels.BlueprintIndexViewModel

@{
    ViewData["Title"] = "Blueprints";
    var totalCount = Model.Blueprints.Count;
    var collectedCount = Model.Blueprints.Count(x => x.Collected || x.CollectionStatus == "Collected");
    var trackingCount = Model.Blueprints.Count(x => x.CollectionStatus == "Tracking");
    var missingCount = totalCount - collectedCount;

    string BlueprintIconClass(string? category)
    {
        var text = (category ?? string.Empty).ToLowerInvariant();
        if (text.Contains("weapon") || text.Contains("gun") || text.Contains("ammo")) return "weapon";
        if (text.Contains("shield") || text.Contains("armor") || text.Contains("defense")) return "shield";
        if (text.Contains("medical") || text.Contains("med") || text.Contains("health")) return "med";
        if (text.Contains("augment") || text.Contains("tool") || text.Contains("utility")) return "tool";
        if (text.Contains("gear") || text.Contains("pack")) return "gear";
        return "intel";
    }

    string BlueprintIconGlyph(string? category)
    {
        var text = (category ?? string.Empty).ToLowerInvariant();
        if (text.Contains("weapon") || text.Contains("gun") || text.Contains("ammo")) return "⚔";
        if (text.Contains("shield") || text.Contains("armor") || text.Contains("defense")) return "⬢";
        if (text.Contains("medical") || text.Contains("med") || text.Contains("health")) return "+";
        if (text.Contains("augment") || text.Contains("tool") || text.Contains("utility")) return "⚙";
        if (text.Contains("gear") || text.Contains("pack")) return "◈";
        return "◆";
    }
}

<section class="ops-hero blueprint-hero" aria-labelledby="blueprint-title">
    <div class="ops-hero-copy">
        <div class="kicker">Blueprint Command Vault</div>
        <h2 id="blueprint-title">Track, route, and prioritize every unlock.</h2>
        <p>
            A companion-grade blueprint workspace that keeps collection status, farm plans,
            container pools, map conditions, and operator actions together.
        </p>
        <div class="ops-hero-actions">
            <a class="button" asp-action="Create">Add Blueprint</a>
            <a class="button secondary" asp-controller="RunPlanner" asp-action="Index" asp-route-selectedGoal="Blueprint Farming" asp-route-selectedStyle="@Model.Playstyle">Plan Blueprint Run</a>
        </div>
    </div>

    <aside class="ops-status-card">
        <div class="intel-line"><span>Total</span><strong>@totalCount</strong></div>
        <div class="intel-line"><span>Collected</span><strong>@collectedCount</strong></div>
        <div class="intel-line"><span>Tracking</span><strong>@trackingCount</strong></div>
        <div class="intel-line"><span>Missing</span><strong>@missingCount</strong></div>
    </aside>
</section>

<section class="kpi-grid blueprint-kpis" aria-label="Blueprint tracker metrics">
    <article class="kpi-card"><span>Collection</span><strong>@collectedCount / @totalCount</strong><small>blueprints secured</small></article>
    <article class="kpi-card"><span>Missing</span><strong>@missingCount</strong><small>remaining unlocks</small></article>
    <article class="kpi-card"><span>Tracked</span><strong>@trackingCount</strong><small>active farm targets</small></article>
    <article class="kpi-card"><span>Playstyle</span><strong>@Model.Playstyle</strong><small>farm plan tuning</small></article>
</section>

<section class="recommendation-card blueprint-filter-card">
    <div class="section-heading compact-heading">
        <div>
            <div class="kicker">Search & Filter</div>
            <h3>Blueprint Intelligence Console</h3>
        </div>
    </div>

    <form method="get" class="search premium-search">
        <input name="searchTerm" value="@Model.SearchTerm" placeholder="Search by name, type, status, location, or materials" />

        <select name="playstyle">
            <option value="Balanced" selected="@(Model.Playstyle == "Balanced")">Balanced</option>
            <option value="PvE" selected="@(Model.Playstyle == "PvE")">PvE</option>
            <option value="PvP" selected="@(Model.Playstyle == "PvP")">PvP</option>
        </select>

        <button type="submit">Search</button>
        <a class="button secondary" asp-action="Index">Clear</a>
    </form>
</section>

<section class="blueprint-card-grid" aria-label="Blueprint cards">
    @foreach (var blueprint in Model.Blueprints)
    {
        var farmPlan = Model.FarmPlans.ContainsKey(blueprint.Id) ? Model.FarmPlans[blueprint.Id] : null;
        var iconPath = Model.IconPaths.TryGetValue(blueprint.Id, out var matchedIconPath) ? matchedIconPath : null;
        var isCollected = blueprint.Collected || blueprint.CollectionStatus == "Collected";
        var statusBadge = isCollected ? "green" : blueprint.CollectionStatus == "Tracking" ? "gold" : "";

        <article class="blueprint-vault-card @(isCollected ? "collected" : "")">
            <div class="blueprint-card-topline">
                <span class="badge @statusBadge">@blueprint.CollectionStatus</span>
                <span class="mini-meta">@blueprint.Category</span>
            </div>

            <h3>
                <span class="item-icon-shell blueprint-icon-shell @BlueprintIconClass(blueprint.Category)" aria-hidden="true">
                    @if (!string.IsNullOrWhiteSpace(iconPath))
                    {
                        <img class="game-item-icon" src="@iconPath" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="item-icon @BlueprintIconClass(blueprint.Category)">@BlueprintIconGlyph(blueprint.Category)</span>
                    }
                </span>
                <span class="item-title">@blueprint.Name</span>
            </h3>
            <p>@(string.IsNullOrWhiteSpace(blueprint.WhereToGet) ? "No source route entered yet." : blueprint.WhereToGet)</p>

            <div class="farm-meta-grid">
                <div><span>Best Map</span><strong>@(farmPlan == null ? "N/A" : farmPlan.BestMap)</strong></div>
                <div><span>Condition</span><strong>@(farmPlan == null ? "N/A" : farmPlan.BestCondition)</strong></div>
                <div><span>Weight</span><strong>@(farmPlan == null ? "N/A" : farmPlan.ProbabilityWeight + "/100")</strong></div>
            </div>

            <div class="blueprint-actions">
                <a asp-action="FarmPlan" asp-route-id="@blueprint.Id" asp-route-playstyle="@Model.Playstyle">Farm Plan</a>
                <a asp-action="Edit" asp-route-id="@blueprint.Id">Edit</a>

                <form asp-action="ToggleCollected" asp-route-id="@blueprint.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link-button">@(isCollected ? "Undo" : "Collected")</button>
                </form>

                <form asp-action="MarkTracking" asp-route-id="@blueprint.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link-button">Track</button>
                </form>

                <form asp-controller="Favorites" asp-action="Toggle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="itemType" value="Blueprint" />
                    <input type="hidden" name="itemId" value="@blueprint.Id" />
                    <input type="hidden" name="displayName" value="@blueprint.Name" />
                    <input type="hidden" name="returnController" value="Blueprints" />
                    <input type="hidden" name="returnAction" value="Index" />
                    <button type="submit" class="link-button">Pin</button>
                </form>

                <a asp-action="Delete" asp-route-id="@blueprint.Id">Delete</a>
            </div>
        </article>
    }
</section>
