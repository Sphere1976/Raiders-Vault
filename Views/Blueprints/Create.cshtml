@model RaidersVault.Models.Blueprint

@{
    ViewData["Title"] = "Add Blueprint";
}

<h2>Add Blueprint</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label>Name</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="error"></span>

    <label>Item Type</label>
    <select asp-for="Category">
        <option value="">Select</option>
        <option value="Weapon">Weapon</option>
        <option value="Quick Use">Quick Use</option>
        <option value="Augment">Augment</option>
        <option value="Material">Material</option>
        <option value="Mine">Mine</option>
        <option value="Grenade">Grenade</option>
        <option value="Mod">Mod</option>
        <option value="Ammo">Ammo</option>
    </select>
    <span asp-validation-for="Category" class="error"></span>

    <label>Collection Status</label>
    <select asp-for="CollectionStatus">
        <option value="">Select</option>
        <option value="Not Collected">Not Collected</option>
        <option value="Tracking">Tracking</option>
        <option value="Collected">Collected</option>
    </select>
    <span asp-validation-for="CollectionStatus" class="error"></span>

    <div class="checkbox-row">
        <label asp-for="Collected">Collected</label>
        <input asp-for="Collected" type="checkbox" />
    </div>

    <label>Recipe Materials</label>
    <textarea asp-for="RecipeMaterials"></textarea>
    <span asp-validation-for="RecipeMaterials" class="error"></span>

    <label>Where to Get</label>
    <input asp-for="WhereToGet" />
    <span asp-validation-for="WhereToGet" class="error"></span>

    <label>Description / Notes</label>
    <textarea asp-for="Notes"></textarea>
    <span asp-validation-for="Notes" class="error"></span>

    <button type="submit">Save</button>
    <a asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}