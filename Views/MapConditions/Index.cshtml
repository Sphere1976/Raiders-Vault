@model RaidersVault.ViewModels.MapConditionRecommendationViewModel

@{
    ViewData["Title"] = "Operations Planning Center";

    var loadout = Model.OptimalLoadout;
    var alertCount = Model.BlueprintAlerts.Count;
    var topAlerts = Model.BlueprintAlerts.Take(6).ToList();
    var routeStops = topAlerts
        .SelectMany(x => x.BestAreas.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Take(4)
        .ToList();

    if (!routeStops.Any())
    {
        routeStops = new List<string>
        {
            "Confirm spawn position",
            "Move through primary loot lanes",
            "Check objective overlap",
            "Extract with priority inventory"
        };
    }

    var riskClass = Model.RiskLevel.Contains("High", StringComparison.OrdinalIgnoreCase)
        ? "danger"
        : Model.RiskLevel.Contains("Low", StringComparison.OrdinalIgnoreCase)
            ? "green"
            : "gold";
}

<section class="ops-hero" aria-labelledby="ops-title">
    <div class="ops-hero-copy">
        <div class="kicker">Operations Planning Center</div>
        <h2 id="ops-title">@Model.SelectedMap</h2>
        <p>
            @Model.SelectedCondition operation configured for @Model.SelectedStyle entry.
            Raiders Vault builds a focused route, optimal kit, blueprint targets, and skill direction from the active map condition.
        </p>

        <div class="ops-hero-actions" aria-label="Primary planning actions">
            <a class="button" asp-controller="RunPlanner" asp-action="Index">Open Tactical Planner</a>
            <a class="button secondary" asp-controller="Skills" asp-action="Index" asp-route-totalPoints="@Model.TotalSkillPoints" asp-route-entryStyle="@Model.SelectedStyle">Open Skill Planner</a>
        </div>
    </div>

    <aside class="ops-status-card" aria-label="Current operation status">
        <div class="intel-line"><span>Condition</span><strong>@Model.SelectedCondition</strong></div>
        <div class="intel-line"><span>Risk</span><strong>@Model.RiskLevel</strong></div>
        <div class="intel-line"><span>Blueprint Routes</span><strong>@alertCount active</strong></div>
        <div class="intel-line"><span>Loadout Score</span><strong>@loadout.Score / 100</strong></div>
    </aside>
</section>

<section class="kpi-grid" aria-label="Operation summary metrics">
    <article class="kpi-card">
        <span>Blueprint Targets</span>
        <strong>@alertCount</strong>
        <small>Condition-matched farm routes</small>
    </article>

    <article class="kpi-card">
        <span>Risk Level</span>
        <strong>@Model.RiskLevel</strong>
        <small>Based on map and condition</small>
    </article>

    <article class="kpi-card">
        <span>Skill Points</span>
        <strong>@Model.TotalSkillPoints</strong>
        <small>@Model.SelectedStyle build profile</small>
    </article>

    <article class="kpi-card">
        <span>Route Score</span>
        <strong>@loadout.Score</strong>
        <small>Loadout readiness estimate</small>
    </article>
</section>

<section class="ops-layout">
    <aside class="control-panel card" aria-labelledby="operation-controls-title">
        <div class="kicker">Active Operation</div>
        <h3 id="operation-controls-title">Mission Controls</h3>
        <p class="hint">Select the active map condition and generate a cleaner recommendation.</p>

        <form method="get" class="ops-control-form">
            <label>
                Map
                <select name="selectedMap" onchange="this.form.submit()">
                    @foreach (var map in Model.Maps)
                    {
                        <option value="@map" selected="@(map == Model.SelectedMap)">@map</option>
                    }
                </select>
            </label>

            <label>
                Condition
                <select name="selectedCondition">
                    @foreach (var condition in Model.Conditions)
                    {
                        <option value="@condition" selected="@(condition == Model.SelectedCondition)">@condition</option>
                    }
                </select>
            </label>

            <label>
                Entry Style
                <select name="selectedStyle">
                    @foreach (var style in Model.Styles)
                    {
                        <option value="@style" selected="@(style == Model.SelectedStyle)">@style</option>
                    }
                </select>
            </label>

            <label>
                Skill Points
                <input type="number" name="totalSkillPoints" min="0" value="@Model.TotalSkillPoints" />
            </label>

            <button type="submit">Generate Plan</button>
        </form>
    </aside>

    <div class="ops-main-stack">
        <section class="recommendation-card" aria-labelledby="mission-intel-title">
            <div class="section-heading compact-heading">
                <div>
                    <div class="kicker">Active Intelligence</div>
                    <h3 id="mission-intel-title">Blueprint Opportunities</h3>
                    <p class="hint">Priority targets matched to the selected map and condition.</p>
                </div>
                <span class="badge @riskClass">@Model.RiskLevel Risk</span>
            </div>

            @if (topAlerts.Any())
            {
                <div class="intel-card-grid">
                    @foreach (var alert in topAlerts)
                    {
                        <article class="intel-opportunity-card">
                            <div class="card-topline">
                                <span class="badge gold">@alert.MatchType</span>
                                <span class="hint">Score @alert.PriorityScore</span>
                            </div>
                            <h4>@alert.BlueprintName</h4>
                            <p><strong>@alert.ContainerType</strong></p>
                            <p class="hint">@alert.BestAreas</p>
                            <a class="button small secondary" asp-controller="Blueprints" asp-action="FarmPlan" asp-route-id="@alert.BlueprintId" asp-route-playstyle="@Model.SelectedStyle">Open Intel Report</a>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <h4>No active blueprint route detected</h4>
                    <p class="hint">Switch conditions or track more uncollected blueprints to populate this panel.</p>
                    <a class="button secondary" asp-controller="Blueprints" asp-action="Index">Open Blueprints</a>
                </div>
            }
        </section>

        <section class="recommendation-card" aria-labelledby="route-title">
            <div class="kicker">Recommended Route</div>
            <h3 id="route-title">Mission Route Flow</h3>
            <ol class="route-timeline">
                <li><strong>Spawn Check</strong><span>Confirm closest safe lane before committing to loot.</span></li>
                @foreach (var stop in routeStops)
                {
                    <li><strong>@stop</strong><span>Search priority containers and avoid unnecessary fights.</span></li>
                }
                <li><strong>Extraction</strong><span>Leave once priority items or objectives are secured.</span></li>
            </ol>
        </section>
    </div>
</section>

<section class="ops-layout secondary-layout">
    <section class="recommendation-card" aria-labelledby="loadout-title">
        <div class="section-heading compact-heading">
            <div>
                <div class="kicker">Mission Recommendation</div>
                <h3 id="loadout-title">Optimal Loadout</h3>
            </div>
            <span class="badge teal">@loadout.Score / 100</span>
        </div>

        <div class="loadout-grid">
            <article class="loadout-tile"><span>Primary</span><strong>@loadout.PrimaryWeapon</strong></article>
            <article class="loadout-tile"><span>Secondary</span><strong>@loadout.SecondaryWeapon</strong></article>
            <article class="loadout-tile"><span>Shield</span><strong>@loadout.Shield</strong></article>
            <article class="loadout-tile"><span>Augment</span><strong>@loadout.Augment</strong></article>
        </div>

        <h4>Quick Use Items</h4>
        <div class="badge-row">
            @foreach (var quickItem in loadout.QuickUseItems)
            {
                <span class="badge">@quickItem</span>
            }
        </div>

        <div class="mission-note">
            <strong>Planner Note</strong>
            <p>@loadout.Caution</p>
        </div>
    </section>

    <section class="recommendation-card" aria-labelledby="skill-title">
        <div class="kicker">Tactical Analysis</div>
        <h3 id="skill-title">Skill Focus</h3>
        <p>@Model.SkillTreeFocus</p>

        <div class="skill-meter-list" aria-label="Suggested skill allocation emphasis">
            <div class="skill-meter"><span>Mobility</span><div><i style="width:72%"></i></div><strong>High</strong></div>
            <div class="skill-meter"><span>Survival</span><div><i style="width:68%"></i></div><strong>High</strong></div>
            <div class="skill-meter"><span>Conditioning</span><div><i style="width:58%"></i></div><strong>Med</strong></div>
        </div>

        <a class="button secondary" asp-controller="Skills" asp-action="Index" asp-route-totalPoints="@Model.TotalSkillPoints" asp-route-entryStyle="@Model.SelectedStyle">Open Tactical Analysis</a>
    </section>
</section>

@if (loadout.WhyThisLoadout.Any() || loadout.SkillSynergies.Any())
{
    <section class="cards" aria-label="Loadout explanation and synergies">
        <article class="card">
            <div class="kicker">Why This Loadout</div>
            <h3>Decision Logic</h3>
            <ul class="premium-list">
                @foreach (var reason in loadout.WhyThisLoadout)
                {
                    <li>@reason</li>
                }
            </ul>
        </article>

        <article class="card">
            <div class="kicker">Skill + Loadout Synergy</div>
            <h3>Build Support</h3>
            <ul class="premium-list">
                @foreach (var synergy in loadout.SkillSynergies)
                {
                    <li>@synergy</li>
                }
            </ul>
        </article>
    </section>
}

<section class="recommendation-card" aria-labelledby="planning-details-title">
    <div class="kicker">Planning Details</div>
    <h3 id="planning-details-title">Loadout Rationale</h3>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Loadout Area</th>
                    <th>Recommendation</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loadoutItem in Model.LoadoutItems)
                {
                    <tr>
                        <td>@loadoutItem.Slot</td>
                        <td>@loadoutItem.Recommendation</td>
                        <td>@loadoutItem.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
