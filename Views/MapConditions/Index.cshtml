@model RaidersVault.ViewModels.MapConditionRecommendationViewModel

@{
    ViewData["Title"] = "Map Conditions Loadouts";

    var loadout = Model.OptimalLoadout;
}

<h2>Map Conditions Loadouts</h2>

<p class="helper-text">
    Pick the map first, then choose from only the conditions
    supported for that map. Stella Montis is limited to
    Standard Patrol and Night Raid. The planner recommends
    a full kit and explains why it fits the run.
</p>

<form method="get" class="recommendation-form">
    <div class="form-grid">
        <label>
            Map

            <select name="selectedMap"
                    onchange="this.form.submit()">

                @foreach (var map in Model.Maps)
                {
                    <option value="@map"
                            selected="@(map == Model.SelectedMap)">
                        @map
                    </option>
                }
            </select>
        </label>

        <label>
            Map Condition

            <span class="small-note">
                Only valid options for the selected map are shown.
            </span>

            <select name="selectedCondition">
                @foreach (var condition in Model.Conditions)
                {
                    <option value="@condition"
                            selected="@(condition == Model.SelectedCondition)">
                        @condition
                    </option>
                }
            </select>
        </label>

        <label>
            Entry Style

            <select name="selectedStyle">
                @foreach (var style in Model.Styles)
                {
                    <option value="@style"
                            selected="@(style == Model.SelectedStyle)">
                        @style
                    </option>
                }
            </select>
        </label>

        <label>
            Current Skill Points

            <input type="number"
                   name="totalSkillPoints"
                   min="0"
                   value="@Model.TotalSkillPoints" />
        </label>
    </div>

    <button type="submit">
        Update Recommendation
    </button>
</form>

@if (Model.BlueprintAlerts.Any())
{
    <section class="notification-panel">
        <div class="kicker">
            Blueprint Condition Alert
        </div>

        <h3>
            @Model.BlueprintAlerts.Count blueprint farm
            @(Model.BlueprintAlerts.Count == 1
                ? "is"
                : "routes are")
            active right now
        </h3>

        <p class="hint">
            These uncollected/tracked blueprints match
            the selected active map condition.
        </p>

        <div class="alert-grid">
            @foreach (var alert in Model.BlueprintAlerts)
            {
                <article class="alert-card">
                    <span class="badge gold">
                        @alert.MatchType
                    </span>

                    <h4>@alert.BlueprintName</h4>

                    <p>
                        <strong>@alert.ActiveMap</strong>
                        — @alert.ActiveCondition
                    </p>

                    <p>
                        <strong>Target:</strong>
                        @alert.ContainerType
                    </p>

                    <p class="hint">
                        @alert.BestAreas
                    </p>

                    <p class="hint">
                        @alert.FarmingRoute
                    </p>

                    <a asp-controller="Blueprints"
                       asp-action="FarmPlan"
                       asp-route-id="@alert.BlueprintId"
                       asp-route-playstyle="@Model.SelectedStyle">
                        Open Farm Plan
                    </a>
                </article>
            }
        </div>
    </section>
}
else
{
    <section class="notification-panel quiet">
        <div class="kicker">
            Blueprint Condition Alert
        </div>

        <h3>
            No tracked blueprint routes match this active condition.
        </h3>

        <p class="hint">
            Try another active map condition or mark more
            blueprints as uncollected/tracking.
        </p>
    </section>
}

<section class="recommendation-card">
    <h3>@Model.Summary</h3>

    <p>
        <strong>Risk Level:</strong>
        @Model.RiskLevel
    </p>

    <p>
        <strong>Skill Tree Focus:</strong>
        @Model.SkillTreeFocus
    </p>

    <p>
        <strong>Loadout Score:</strong>
        @loadout.Score / 100
    </p>

    <p>
        <strong>Planner Note:</strong>
        @loadout.Caution
    </p>

    <p>
        <a asp-controller="Skills"
           asp-action="Index"
           asp-route-totalPoints="@Model.TotalSkillPoints"
           asp-route-entryStyle="@Model.SelectedStyle">

            View detailed skill allocation
        </a>
    </p>
</section>

<section class="recommendation-card">
    <h3>Optimal Loadout</h3>

    <table>
        <tbody>
            <tr>
                <th>Primary Weapon</th>
                <td>@loadout.PrimaryWeapon</td>
            </tr>

            <tr>
                <th>Secondary Weapon</th>
                <td>@loadout.SecondaryWeapon</td>
            </tr>

            <tr>
                <th>Shield</th>
                <td>@loadout.Shield</td>
            </tr>

            <tr>
                <th>Augment</th>
                <td>@loadout.Augment</td>
            </tr>
        </tbody>
    </table>

    <h4>Quick Use Items</h4>

    <ul>
        @foreach (var quickItem in loadout.QuickUseItems)
        {
            <li>@quickItem</li>
        }
    </ul>
</section>

<div class="cards">
    <section class="card wide-card">
        <h4>Why this loadout</h4>

        <ul>
            @foreach (var reason in loadout.WhyThisLoadout)
            {
                <li>@reason</li>
            }
        </ul>
    </section>

    <section class="card wide-card">
        <h4>Skill + Loadout Synergy</h4>

        <ul>
            @foreach (var synergy in loadout.SkillSynergies)
            {
                <li>@synergy</li>
            }
        </ul>
    </section>
</div>

<h3>Planning Details</h3>

<table>
    <thead>
        <tr>
            <th>Loadout Area</th>
            <th>Recommendation</th>
            <th>Reason</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var loadoutItem in Model.LoadoutItems)
        {
            <tr>
                <td>@loadoutItem.Slot</td>

                <td>@loadoutItem.Recommendation</td>

                <td>@loadoutItem.Reason</td>
            </tr>
        }
    </tbody>
</table>

<p class="helper-text">
    Recommendations are rules-based. Map-condition
    availability is filtered by the selected map
    and can be updated later if the live rotation changes.
</p>