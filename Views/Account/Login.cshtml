@{
    ViewData["Title"] = "Login";

    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />

    <title>
        Login - Raiders Vault
    </title>

    <link rel="stylesheet"
          href="~/css/site.css" />
</head>

<body class="login-page">
    <div class="login-box">
        <h1>Raiders Vault</h1>

        <p>
            Sign in to manage loadouts,
            quests, and blueprints.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error">
                @ViewBag.Error
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="error">
            </div>

            <label>
                Username
            </label>

            <input name="username"
                   required />

            <label>
                Password
            </label>

            <input name="password"
                   type="password"
                   required />

            <button type="submit">
                Login
            </button>
        </form>

        <p class="hint">
            Demo login: admin / password
        </p>
    </div>
</body>
</html>