@{
    ViewData["Title"] = "Command Center";

    var nextRunTitle = ViewBag.NextRunTitle ?? "Balanced loot and objective run";
    var nextRunMap = ViewBag.NextRunMap ?? "Dam Battlegrounds";
    var nextRunCondition = ViewBag.NextRunCondition ?? "Standard Patrol";
    var nextRunGoal = ViewBag.NextRunGoal ?? "Complete Quests";
    var playerName = ViewBag.PlayerName ?? "Raider";
    var preferredPlaystyle = ViewBag.PreferredPlaystyle ?? "Balanced";
    var currentSkillPoints = ViewBag.CurrentSkillPoints ?? 20;
    var defaultMap = ViewBag.DefaultMap ?? "Dam Battlegrounds";

    var loadoutCount = ViewBag.LoadoutCount ?? 0;
    var favoriteCount = ViewBag.FavoriteCount ?? 0;
    var completedQuestCount = ViewBag.CompletedQuestCount ?? 0;
    var questCount = ViewBag.QuestCount ?? 0;
    var questCompletionPercent = ViewBag.QuestCompletionPercent ?? 0;
    var activeQuestCount = ViewBag.ActiveQuestCount ?? 0;
    var collectedBlueprintCount = ViewBag.CollectedBlueprintCount ?? 0;
    var blueprintCount = ViewBag.BlueprintCount ?? 0;
    var blueprintCompletionPercent = ViewBag.BlueprintCompletionPercent ?? 0;
    var remainingBlueprintCount = ViewBag.RemainingBlueprintCount ?? 0;
}

<section class="mega-hero">
    <div class="hero-copy">
        <div class="kicker">Raiders Vault // Enterprise Command OS</div>
        <h1>Build the run. Track the grind. Extract smarter.</h1>
        <p>
            A bigger, brighter ARC Raiders planning platform for loadouts, objectives, blueprints,
            skill allocation, map conditions, farm routes, favorites, and reporting.
        </p>

        <div class="hero-actions">
            <a class="button" asp-controller="RunPlanner" asp-action="Index">Launch Run Planner</a>
            <a class="button secondary" asp-controller="GlobalOps" asp-action="Index">Global Ops</a>
            <a class="button secondary" asp-controller="Blueprints" asp-action="Index">Blueprint Tracker</a>
            <a class="button secondary" asp-controller="MapConditions" asp-action="Index">Map Intelligence</a>
            <a class="button secondary" asp-controller="Reports" asp-action="Index">Open Analytics</a>
        </div>
    </div>

    <aside class="hero-intel-card" aria-label="Next recommended run">
        <div class="kicker">Next Best Run</div>
        <h3>@nextRunTitle</h3>
        <div class="intel-line"><span>Map</span><strong>@nextRunMap</strong></div>
        <div class="intel-line"><span>Condition</span><strong>@nextRunCondition</strong></div>
        <div class="intel-line"><span>Goal</span><strong>@nextRunGoal</strong></div>
        <p class="hint">Profile: @playerName // @preferredPlaystyle // @currentSkillPoints skill points</p>
        <a class="button" asp-controller="RunPlanner" asp-action="Index" asp-route-selectedMap="@defaultMap" asp-route-selectedStyle="@preferredPlaystyle" asp-route-totalSkillPoints="@currentSkillPoints">Build This Run</a>
    </aside>
</section>

<section class="mission-control-grid" aria-label="Mission control statistics">
    <article class="metric-card neon-blue">
        <span class="metric-label">Saved Kits</span>
        <strong class="stat">@loadoutCount</strong>
        <p>Complete weapon, shield, augment, and quick-use setups.</p>
        <a asp-controller="Loadouts" asp-action="Index">Manage Loadouts</a>
    </article>

    <article class="metric-card neon-purple">
        <span class="metric-label">Pinned Intel</span>
        <strong class="stat">@favoriteCount</strong>
        <p>Favorite loadouts, blueprints, objectives, and planning targets.</p>
        <a asp-controller="Favorites" asp-action="Index">Open Watchlist</a>
    </article>

    <article class="metric-card neon-green">
        <span class="metric-label">Objectives</span>
        <strong class="stat">@completedQuestCount / @questCount</strong>
        <h3>@questCompletionPercent% Complete</h3>
        <div class="progress-shell"><div class="progress-fill" style="@($"width:{questCompletionPercent}%")"></div></div>
        <p>@activeQuestCount objectives remain active.</p>
        <a asp-controller="Quests" asp-action="Index">Update Objectives</a>
    </article>

    <article class="metric-card neon-gold">
        <span class="metric-label">Blueprint Vault</span>
        <strong class="stat">@collectedBlueprintCount / @blueprintCount</strong>
        <h3>@blueprintCompletionPercent% Collected</h3>
        <div class="progress-shell"><div class="progress-fill" style="@($"width:{blueprintCompletionPercent}%")"></div></div>
        <p>@remainingBlueprintCount blueprints remain in the farm plan.</p>
        <a asp-controller="Blueprints" asp-action="Index">Track Blueprints</a>
    </article>
</section>

<section class="vault-console">
    <div class="section-heading">
        <div>
            <div class="kicker">Inspired by modern game companion hubs</div>
            <h2>One premium command center for every ARC Raiders workflow.</h2>
        </div>
        <a class="button secondary" asp-controller="Profile" asp-action="Index">Tune Operator Profile</a>
    </div>

    <div class="console-modules">
        <a class="module-card" asp-controller="Blueprints" asp-action="Index">
            <span class="module-icon">◆</span>
            <strong>Blueprint Tracker</strong>
            <p>Search, collect, prioritize, and route blueprint farming.</p>
            <small>Collection progress // missing items // farm plans</small>
        </a>

        <a class="module-card" asp-controller="GlobalOps" asp-action="Index">
            <span class="module-icon">GO</span>
            <strong>Global Ops Center</strong>
            <p>Monitor worldwide readiness, regional play windows, marketplace signals, and inventory gaps.</p>
            <small>Regions // value signals // enterprise controls</small>
        </a>

        <a class="module-card" asp-controller="Admin" asp-action="Index">
            <span class="module-icon">AD</span>
            <strong>Admin Center</strong>
            <p>Review security posture, integration endpoints, audit activity, and platform governance.</p>
            <small>Audit trail // health // API registry</small>
        </a>

        <a class="module-card" asp-controller="RunPlanner" asp-action="Index">
            <span class="module-icon">◈</span>
            <strong>Run Planner</strong>
            <p>Generate tactical recommendations from playstyle, map, and condition.</p>
            <small>PvE // PvP // Balanced</small>
        </a>

        <a class="module-card" asp-controller="MapConditions" asp-action="Index">
            <span class="module-icon">▲</span>
            <strong>Map Intelligence</strong>
            <p>Match loadouts to Standard, Night, Storm, Beachcomber, and special conditions.</p>
            <small>Riven Tides // Stella Montis // Dam Battlegrounds</small>
        </a>

        <a class="module-card" asp-controller="Skills" asp-action="Index">
            <span class="module-icon">✦</span>
            <strong>Skill Builder</strong>
            <p>Plan Mobility, Survival, and Conditioning point allocation.</p>
            <small>Point planning // recommendations // build focus</small>
        </a>

        <a class="module-card" asp-controller="Quests" asp-action="Index">
            <span class="module-icon">✚</span>
            <strong>Objective Board</strong>
            <p>Track active, completed, reopened, and searched objectives.</p>
            <small>Quest pipeline // progress // next action</small>
        </a>

        <a class="module-card" asp-controller="Reports" asp-action="Index">
            <span class="module-icon">▣</span>
            <strong>Analytics Reports</strong>
            <p>Generate planning summaries across loadouts, quests, and blueprints.</p>
            <small>Portfolio-ready reporting // evaluator-friendly output</small>
        </a>
    </div>
</section>

<section class="split premium-split">
    <div class="panel priority-panel">
        <div class="kicker">Tactical Workflow</div>
        <h3>Recommended command sequence</h3>
        <ol class="timeline-list">
            <li><strong>Select active map and condition.</strong><span>Start with current environment pressure before choosing gear.</span></li>
            <li><strong>Generate the run recommendation.</strong><span>Compare PvE, PvP, and balanced outputs for the next drop.</span></li>
            <li><strong>Lock loadout and skill focus.</strong><span>Confirm weapons, augment, shield, quick-use, and skill path.</span></li>
            <li><strong>Route blueprint farming.</strong><span>Prioritize missing blueprints by map, container, condition, and route.</span></li>
        </ol>
    </div>

    <div class="panel priority-panel">
        <div class="kicker">High-Impact Upgrades</div>
        <h3>Enterprise polish already built in</h3>
        <div class="badge-row mega-badges">
            <span class="badge teal">ASP.NET Core MVC</span>
            <span class="badge green">SQLite + EF Core</span>
            <span class="badge gold">Cloud Run Ready</span>
            <span class="badge">CRUD Workflows</span>
            <span class="badge">Search + Filters</span>
            <span class="badge">Farm Plans</span>
            <span class="badge">Reports</span>
            <span class="badge">Session Auth</span>
        </div>
        <p class="hint">The application now presents like a polished production dashboard instead of a basic school project.</p>
    </div>
</section>
